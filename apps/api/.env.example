# Copier en .env pour le développement local
DATABASE_URL=postgresql://ardoise:ardoise@localhost:5432/ardoise_dev
PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
# Lien public envoyé aux clients (page de paiement)
PUBLIC_PAY_URL=http://localhost:3000/p
# sandbox | notchpay
PAYMENT_PROVIDER=sandbox
WEBHOOK_SECRET=dev-webhook-secret
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HEADER=x-notch-signature
# console = le code OTP est écrit dans les logs (dev uniquement)
SMS_PROVIDER=console
OTP_DEV_ECHO=true
# Tâches périodiques : rattrapage des paiements (1 min) et relances automatiques (5 min)
ENABLE_JOBS=true
